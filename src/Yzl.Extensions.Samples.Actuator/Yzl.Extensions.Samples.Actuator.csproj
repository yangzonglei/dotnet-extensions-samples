<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Yzl.Extensions.Samples.Actuator</RootNamespace>
  </PropertyGroup>

  <!-- 开发模式：源码引用（需 ../dotnet-extensions 存在） -->
  <ItemGroup Condition="'$(UseProjectReference)' == 'true'">
    <ProjectReference Include="..\..\..\dotnet-extensions\src\Yzl.Extensions.Actuator\Yzl.Extensions.Actuator.csproj" />
    <ProjectReference Include="..\..\..\dotnet-extensions\src\Yzl.Extensions.Core\Yzl.Extensions.Core.csproj" />
  </ItemGroup>

  <!-- 默认模式：NuGet 包引用 -->
  <ItemGroup Condition="'$(UseProjectReference)' != 'true'">
    <PackageReference Include="Yzl.Extensions.Actuator" />
    <PackageReference Include="Yzl.Extensions.Core" />
  </ItemGroup>

  <!-- 公共测试面板 -->
  <ItemGroup>
    <ProjectReference Include="..\Yzl.Extensions.Samples.TestDashboard\Yzl.Extensions.Samples.TestDashboard.csproj" />
  </ItemGroup>

  <!--
    NLog：/actuator/loggers 端点由 NLogLoggerManagement 提供，
    它在找不到 NLog 配置时会抛 InvalidOperationException("No NLog configuration found.")。
    因此本示例接入 NLog（nlog.config 由 NLog.Web.AspNetCore 自动复制到输出目录），
    使 /actuator/loggers 的查询与运行时改级别真正可用。
  -->
  <ItemGroup>
    <PackageReference Include="NLog.Web.AspNetCore" />
  </ItemGroup>
</Project>
