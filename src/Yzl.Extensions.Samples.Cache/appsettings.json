{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yzl.Extensions.Cache": "Information"
    }
  },
  "AllowedHosts": "*",

  "spring": {
    "data": {
      "redis": {
        "host": "localhost",
        "port": 6399,
        "database": 5,
        "connection-string": "abortConnect=false,connectRetry=3",
        "connect-timeout": "2s",
        "timeout": "2s",
        "client-name": "samples-cache-config-backend"
      }
    }
  },

  "redis:samples-injected": "localhost:6399,defaultDatabase=7,abortConnect=false"
}
