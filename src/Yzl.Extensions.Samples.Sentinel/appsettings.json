{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "spring": {
    "cloud": {
      "sentinel": {
        "enabled": true,
        "eager": true,

        "transport": {
          "dashboard": "127.0.0.1:8080",
          "port": 8719
        },

        "flow": {
          "cold-factor": 3
        },

        "filter": {
          "urlPatterns": ["/**"],
          "excludeUrlPatterns": [
            "/favicon.ico",
            "/",
            "/Home/Index",
            "/Home/Error",
            "/actuator/prometheus"
          ],
          "origin-header": "X-App-Id",
          "origin-query": "appId"
        },

        "datasource-temp": {
          "flow": {
            "nacos": {
              "server-addresses": [""],
              "namespace": "fa9dc1b8-23b7-4ed7-8b48-62d18adc700f",
              "data-id": "flow-config",
              "group-id": "DEV",
              "rule-type": "flow",
              "username": "",
              "password": ""
            }
          },
          "degrade": {
            "nacos": {
              "server-addresses": [""],
              "namespace": "fa9dc1b8-23b7-4ed7-8b48-62d18adc700f",
              "data-id": "degrade-config",
              "group-id": "DEV",
              "rule-type": "degrade",
              "username": "",
              "password": ""
            }
          }
        },

        "rules": {
          "flow": [
            {
              "description": "测试用例-阈值类型QPS×流控模式直接×流控效果快速失败（页面版）：验证超过 count=2 QPS 即 429，渲染 RateLimit1.cshtml（URL 不变）。触发：浏览器 F5 连点超过 2 QPS。",
              "resource": "flow:page:qps-fast-fail",
              "limitApp": "default",
              "grade": 1,
              "count": 2,
              "strategy": 0,
              "controlBehavior": 0
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式直接×流控效果预热WarmUp（页面版）：验证冷启动阈值从约 count/3 爬升到 count=10（warmUpPeriodSec=10，预热因子 spring.cloud.sentinel.flow.cold-factor=3）。触发：应用空闲 3~5 秒后连续刷新，早期低压通过、随后 10s 内爬升到 10 QPS 全速，超过当前可放行速率即 429。",
              "resource": "flow:page:qps-warmup",
              "limitApp": "default",
              "grade": 1,
              "count": 10,
              "strategy": 0,
              "controlBehavior": 1,
              "warmUpPeriodSec": 10
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式直接×流控效果匀速排队（页面版）：验证控制行为 rate-limiter，请求按 count=1 匀速放行（引擎内 Task.Delay 排队，约 1s 间隔），预计等待超过 maxQueueingTimeMs=5000 才 429。触发：并发连刷观察本页时间戳间距。",
              "resource": "flow:page:qps-queue-wait",
              "limitApp": "default",
              "grade": 1,
              "count": 1,
              "strategy": 0,
              "controlBehavior": 2,
              "maxQueueingTimeMs": 5000
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式关联（strategy=1）×流控效果快速失败（页面版，A 侧）：验证 A 的限流判定用 refResource=flow:page:related-source（B）的统计节点。触发：并发刷 B（/FlowDemo/RelatedSource）→ A 立即 429，B 本身不限。",
              "resource": "flow:page:related",
              "limitApp": "default",
              "grade": 1,
              "count": 1,
              "strategy": 1,
              "controlBehavior": 0,
              "refResource": "flow:page:related-source"
            },
            {
              "description": "测试用例-关联流控的流量源 B（占位规则）：count=100 无实际限流，供 A（/FlowDemo/Related）做关联限流压测，避免 B 节点为空。",
              "resource": "flow:page:related-source",
              "limitApp": "default",
              "grade": 1,
              "count": 100,
              "strategy": 0,
              "controlBehavior": 0
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式链路（strategy=2）×流控效果快速失败（页面版，退化直连）：.NET 库无调用链上下文，refResource 仅用于通过规则校验（Validator 要求非空），判定退化为直连。触发：快速刷新超过 count=2 QPS 即 429。",
              "resource": "flow:page:chain",
              "limitApp": "default",
              "grade": 1,
              "count": 2,
              "strategy": 2,
              "controlBehavior": 0,
              "refResource": "flow:page:chain"
            },
            {
              "description": "测试用例-阈值类型线程数（grade=0）×流控模式直接×流控效果快速失败（页面版）：验证并发在途线程数超过 count=2 时第 3 个请求 429。触发：并发同时发 3+ 请求（动作持有 500ms 制造窗口重叠）。",
              "resource": "flow:page:thread",
              "limitApp": "default",
              "grade": 0,
              "count": 2,
              "strategy": 0,
              "controlBehavior": 0
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式直接×流控效果快速失败（API 版）：超过 count=2 QPS 即返回 429 JSON（[ApiController] 恒走 JsonTemplate）。触发：并发/快速调用超过 2 QPS。",
              "resource": "/api/flow/qps-fast-fail",
              "limitApp": "default",
              "grade": 1,
              "count": 2,
              "strategy": 0,
              "controlBehavior": 0
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式直接×流控效果预热WarmUp（API 版）：冷启动阈值从约 count/3 爬升到 count=10（warmUpPeriodSec=10）。触发：空闲 3~5 秒后连续调用观察阈值爬升，超过当前可放行速率即 429 JSON。",
              "resource": "/api/flow/qps-warmup",
              "limitApp": "default",
              "grade": 1,
              "count": 10,
              "strategy": 0,
              "controlBehavior": 1,
              "warmUpPeriodSec": 10
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式直接×流控效果匀速排队（API 版）：按 count=1 匀速放行（约 1s 间隔），预计等待超过 maxQueueingTimeMs=5000 才 429 JSON。触发：并发连调观察 time 字段间距。",
              "resource": "/api/flow/qps-queue-wait",
              "limitApp": "default",
              "grade": 1,
              "count": 1,
              "strategy": 0,
              "controlBehavior": 2,
              "maxQueueingTimeMs": 5000
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式关联（strategy=1）×流控效果快速失败（API 版，A 侧）：A 的判定用 refResource=/api/flow/related-source（B）节点。触发：并发压 B → A 429 JSON，B 本身不限。",
              "resource": "/api/flow/related",
              "limitApp": "default",
              "grade": 1,
              "count": 1,
              "strategy": 1,
              "controlBehavior": 0,
              "refResource": "/api/flow/related-source"
            },
            {
              "description": "测试用例-关联流控的流量源 B（API 版，占位）：count=100 无实际限流，供 A（/api/flow/related）做关联限流压测，避免 B 节点为空。",
              "resource": "/api/flow/related-source",
              "limitApp": "default",
              "grade": 1,
              "count": 100,
              "strategy": 0,
              "controlBehavior": 0
            },
            {
              "description": "测试用例-阈值类型QPS×流控模式链路（strategy=2）×流控效果快速失败（API 版，退化直连）：refResource 仅用于通过规则校验，语义退化为直连。触发：快速调用超过 count=2 QPS 即 429 JSON。",
              "resource": "/api/flow/chain",
              "limitApp": "default",
              "grade": 1,
              "count": 2,
              "strategy": 2,
              "controlBehavior": 0,
              "refResource": "/api/flow/chain"
            },
            {
              "description": "测试用例-阈值类型线程数（grade=0）×流控模式直接×流控效果快速失败（API 版）：并发在途线程数超过 count=2 时第 3 个请求 429 JSON。触发：并发同时发 3+ 请求（动作持有 500ms 制造窗口重叠）。",
              "resource": "/api/flow/thread",
              "limitApp": "default",
              "grade": 0,
              "count": 2,
              "strategy": 0,
              "controlBehavior": 0
            }
          ],
          "degrade": [
            {
              "description": "测试用例-慢调用比例熔断（grade=0，页面版 DegradeDemo/SlowRatio）：RT 阈值 count=300ms，1s 窗口内慢请求占比 ≥ slowRatioThreshold=0.5 且请求数 ≥ minRequestAmount=5 时熔断 timeWindow=10s。触发：并发同时刷 5+ 个请求（本页故意耗时 400ms）→ 熔断后 429。",
              "resource": "degrade:slow-ratio",
              "limitApp": "default",
              "grade": 0,
              "count": 300,
              "timeWindow": 10,
              "minRequestAmount": 5,
              "slowRatioThreshold": 0.5,
              "statIntervalMs": 1000
            },
            {
              "description": "测试用例-异常比例熔断（grade=1，页面版 DegradeDemo/ErrorRatio）：异常比例阈值 count=0.5，1s 窗口内请求数 ≥ 5 且异常比例 > 50% 时熔断 10s。触发：?fail=true 抛异常，并发同时刷 5+ 个请求 → 熔断后走 fallback 降级 429。",
              "resource": "degrade:error-ratio",
              "limitApp": "default",
              "grade": 1,
              "count": 0.5,
              "timeWindow": 10,
              "minRequestAmount": 5,
              "slowRatioThreshold": 1.0,
              "statIntervalMs": 1000
            },
            {
              "description": "测试用例-异常数熔断（grade=2，页面版 DegradeDemo/ErrorCount）：累计异常数阈值 count=3，1s 窗口内请求数 ≥ 5 且异常数 > 3 时熔断 10s。触发：?fail=true 抛异常，并发同时刷 5+ 个请求 → 熔断后走 blockHandler 降级 429。",
              "resource": "degrade:error-count",
              "limitApp": "default",
              "grade": 2,
              "count": 3,
              "timeWindow": 10,
              "minRequestAmount": 5,
              "slowRatioThreshold": 1.0,
              "statIntervalMs": 1000
            },
            {
              "description": "测试用例-异常数熔断（grade=2，API 版 DegradeApi /api/degrade/fail）：累计异常数阈值 count=2，minRequestAmount=1（1 个请求即可计入），连续 2 次抛异常即熔断 10s。触发：连调 ?fail=true 两次 → 熔断期间请求被中间件拦截返回 429 JSON（经全局异常处理）。",
              "resource": "degrade:api:error-count",
              "limitApp": "default",
              "grade": 2,
              "count": 2,
              "timeWindow": 10,
              "minRequestAmount": 1,
              "slowRatioThreshold": 1.0,
              "statIntervalMs": 1000
            },
            {
              "description": "测试用例-慢调用比例熔断（grade=0，页面版 Home/Slow）：RT 阈值 count=300ms，1s 窗口内慢请求占比 ≥ slowRatioThreshold=0.5 且请求数 ≥ 5 时熔断 10s。触发：并发同时刷 5+ 个请求（本页故意耗时 400ms）→ 熔断后 429。",
              "resource": "/Home/Slow",
              "limitApp": "default",
              "grade": 0,
              "count": 300,
              "timeWindow": 10,
              "minRequestAmount": 5,
              "slowRatioThreshold": 0.5,
              "statIntervalMs": 1000
            }
          ]
        }
      }
    }
  }
}
